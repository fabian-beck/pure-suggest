{
  "name": "pure",
  "version": "0.12.3",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --open",
    "lint": "eslint src tests tools",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:perf": "vitest run --config vite.config.perf.mjs",
    "test:perf:watch": "vitest --config vite.config.perf.mjs",
    "test:all": "npm test && npm run test:perf"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "bulma": "^1.0.4",
    "core-js": "^3.51.0",
    "d3": "^7.9.2",
    "idb-keyval": "^6.3.0",
    "lz-string": "^1.5.0",
    "pinia": "^4.1.0",
    "sass": "^1.108.2",
    "tippy.js": "^6.3.7",
    "vue": "^3.5.45",
    "vue-tippy": "^6.8.0",
    "vuetify": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/vue": "^8.1.0",
    "@typescript-eslint/utils": "^8.72.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/compiler-sfc": "^3.5.45",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "puppeteer": "^25.17.0",
    "ts-api-utils": "^2.5.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
}
