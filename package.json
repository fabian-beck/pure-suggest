{
  "name": "pure",
  "version": "0.12.2",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --open",
    "lint": "eslint src tests tools",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:perf": "vitest run --config vite.config.perf.mjs",
    "test:perf:watch": "vitest --config vite.config.perf.mjs",
    "test:all": "npm test && npm run test:perf"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "bulma": "^1.0.4",
    "core-js": "^3.50.0",
    "d3": "^7",
    "idb-keyval": "^6.3.0",
    "lz-string": "^1.5.0",
    "pinia": "^4.0.3",
    "sass": "^1.104.0",
    "tippy.js": "^6.3.7",
    "vue": "^3.5.42",
    "vue-tippy": "^6.7.1",
    "vuetify": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/vue": "^8.1.0",
    "@typescript-eslint/utils": "^8.70.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.42",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.3",
    "prettier": "^3.9.6",
    "puppeteer": "^25.10.0",
    "ts-api-utils": "^2.5.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
}
